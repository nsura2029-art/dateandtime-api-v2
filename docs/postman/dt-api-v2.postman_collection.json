        {
          "name": "[Happy] Search 'Mumbai' (English, exact match)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cities/search?q=Mumbai&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cities", "search"],
              "query": [
                {"key": "q", "value": "Mumbai"},
                {"key": "limit", "value": "5"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().data;",
                  "pm.test('Has results', () => pm.expect(r.results).to.be.an('array'));",
                  "pm.test('First result is Mumbai IN', () => {",
                  "  const first = r.results[0];",
                  "  pm.expect(first.name).to.match(/Mumbai|Navi Mumbai/);",
                  "  pm.expect(first.country.cca2).to.eql('IN');",
                  "});",
                  "pm.test('Match type is exact or prefix', () => pm.expect(['exact','prefix']).to.include(r.results[0].matchType));",
                  "pm.test('Has timezone info', () => {",
                  "  pm.expect(r.results[0].timezone.id).to.be.a('string');",
                  "  pm.expect(r.results[0].timezone.utc_offset_minutes).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
