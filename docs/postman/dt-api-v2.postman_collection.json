  "info": {
    "name": "dateandtime-api-v2 (2.0.0)",
    "_postman_id": "dt-api-v2-2026-08-02",
    "description": "dateandtime.live API v2 \u2014 Hono + Cloudflare D1 + Zod.\n\n**Coverage:** 170,253 cities, 250 countries, 408 IANA timezones, 15,638 holiday occurrences (M14 Calendarific), 47,549 admin-2 regions.\n\n**Holidays (M14):** 10 endpoints covering filter catalog, country variants, list/detail/today/upcoming, long weekends (legacy + enhanced with PTO strategies), pto-strategy greedy planner, ICS export, feedback.\n\nSee https://github.com/nsura2029-art/dateandtime-api-v2 for source. Read `/docs/api/README.md` for the API reference and `/docs/m14.6-trip-planner/USE_CASES.md` for the long weekend planner use cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
