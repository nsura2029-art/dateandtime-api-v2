        {
          "name": "[Happy] Get Mumbai (id=133024)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cities/133024",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cities", "133024"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('id matches', () => pm.expect(d.id).to.eql(133024));",
                  "pm.test('name is Mumbai', () => pm.expect(d.name).to.eql('Mumbai'));",
                  "pm.test('Has country', () => {",
                  "  pm.expect(d.country.cca2).to.eql('IN');",
                  "  pm.expect(d.country.name).to.eql('India');",
                  "});",
                  "pm.test('Has admin region', () => {",
                  "  pm.expect(d.adminRegion).to.exist;",
                  "  pm.expect(d.adminRegion.name).to.eql('Maharashtra');",
                  "});",
                  "pm.test('Has timezone', () => {",
                  "  pm.expect(d.timezone.id).to.eql('Asia/Kolkata');",
                  "  pm.expect(d.timezone.utc_offset_minutes).to.eql(330);",
                  "  pm.expect(d.timezone.current_abbreviation).to.eql('IST');",
