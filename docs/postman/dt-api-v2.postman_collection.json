          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Has data.name', () => pm.expect(pm.response.json().data.name).to.be.a('string'));",
                  "pm.test('Has data.endpoints', () => pm.expect(pm.response.json().data.endpoints).to.be.an('object'));",
