{
  "info": {
    "name": "dateandtime-api-v2",
    "description": "API collection for dateandtime.live v2 API. Each request includes test scripts that verify happy-path responses, plus edge-case variants.\n\nBase URL: https://dt-api-v2-dev.nsura2029.workers.dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dt-api-v2-dev.nsura2029.workers.dev",
      "type": "string"
    }
  ],
  "item": [
