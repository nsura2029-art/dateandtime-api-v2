{
  "name": "@dateandtime/api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dateandtime.live API v2 — Hono + D1 + Zod, deployed on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:remote": "wrangler dev --port 8787 --remote",
    "dev:docker": "docker compose -f docker/docker-compose.yml up",
    "dev:docker:remote": "docker compose -f docker/docker-compose.yml --profile remote up",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "deploy:dev:dry": "bash scripts/deploy.sh dev --dry-run",
    "tail:dev": "wrangler tail --env dev",
    "tail:prod": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"tests/**/*.ts\"",
    "migrate:dev": "wrangler d1 execute timeandtimepro-full --env dev --file=migrations/000_initial.sql",
    "migrate:prod": "wrangler d1 execute timeandtimepro-full --file=migrations/000_initial.sql",
    "smoke": "bash scripts/test-endpoints.sh",
    "sync:readme": "bash scripts/sync-readme.sh",
    "sync:readme:check": "bash scripts/sync-readme.sh --check",
    "verify": "bash scripts/verify-and-run.sh",
    "verify:checks": "bash scripts/verify-and-run.sh --checks-only",
    "verify:server": "bash scripts/verify-and-run.sh --server-only"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.16.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "~4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "~3.114.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
