# Local dev env vars — copy to .dev.vars for `wrangler dev`
# (.dev.vars is gitignored, this file is the template)

# CORS allowed origins (comma-separated). Use "*" for dev only.
ALLOWED_ORIGINS="*"

# Admin API key (for /api/v1/admin/* endpoints). Leave empty to disable admin routes.
ADMIN_API_KEY=""

# Log level: debug | info | warn | error
LOG_LEVEL="debug"
