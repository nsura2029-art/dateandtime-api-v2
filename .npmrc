# .npmrc — project-wide npm config
# This file is committed. Use .env or .dev.vars for secrets.

# Engine check: project requires Node 22.13+ or 24+
engine-strict=true

# npm 11 no longer has 'strict-peer-dependencies' as a config option.
# Default behavior in npm 11+ is to warn (not fail) on peer dep conflicts.
# If you need to bypass peer deps entirely (e.g., for a known-good mismatch),
# use: npm install --legacy-peer-deps
#
# We do NOT set legacy-peer-deps=true by default because it masks real issues.

# save-exact is intentionally false — we use ^ ranges in package.json
# to allow patch/minor updates within a major. The lock file pins exact
# versions, so `npm ci` will still be reproducible.
save-exact=false
