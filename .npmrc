# .npmrc — project-wide npm config
# This file is committed. Use .env or .dev.vars for secrets.

# Always use the exact versions from package-lock.json.
# If you want a newer version of a dep, update package.json + lock
# together and commit both. Never mix-and-match.
save-exact=false

# Peer dep violations are usually real problems. Make them loud.
# Use --legacy-peer-deps only if you know what you're doing.
strict-peer-dependencies=false

# Engine check: project requires Node 22+
engine-strict=true
